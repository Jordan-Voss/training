{
  "name": "training",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.21",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.14",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-sqlite": "58.0.18",
    "expo-status-bar": "58.0.5",
    "expo-video": "58.0.14",
    "fast-xml-parser": "5.12.1",
    "lucide-react-native": "1.74.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-compressor": "2.0.6",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@cloudflare/workers-types": "5.20261117.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "cf": "1.0.0-rc.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p services/integration/tsconfig.json",
    "test": "vitest run",
    "build:web": "expo export --platform web && node scripts/build-web.mjs",
    "worker:dev": "cf dev",
    "worker:check": "cf deploy --prebuilt --dry-run",
    "worker:types": "cf workers types",
    "deploy": "npm run build:web && cf build && cf deploy --prebuilt",
    "ios:build": "npx eas-cli@27.10.0 build --platform ios --profile preview",
    "worker:build": "cf build",
    "format": "prettier --write app src packages services tests scripts *.ts *.mts *.json docs/*.md README.md"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
